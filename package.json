{
  "name": "dsp-toolkit",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "24.22.1",
    "pnpm": "10.28.2"
  },
  "scripts": {
    "prepare": "if [ \"$CI\" != \"true\" ]; then husky && git config commit.template .gitmessage; fi",
    "bootstrap:check": "node ./scripts/bootstrap-check.mjs",
    "new:package": "node ./scripts/create-package.mjs",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "test": "turbo test",
    "test:ci": "turbo test:ci",
    "quality:ci": "pnpm run check:versions && pnpm run security:audit && turbo lint format:check typecheck test:ci build",
    "quality:ci:changed": "pnpm run check:versions && pnpm run security:audit && turbo lint format:check typecheck test:ci build --filter=[origin/main...HEAD]",
    "quality:ci:services": "pnpm run quality:ci -- --filter=@agrimetrics/services",
    "quality:ci:events": "pnpm run quality:ci -- --filter=@agrimetrics/agrieventlib",
    "quality:ci:types": "pnpm run quality:ci -- --filter=@agrimetrics/service-event-types",
    "release": "turbo release",
    "release:services": "pnpm --filter @agrimetrics/services exec semantic-release",
    "release:events": "pnpm --filter @agrimetrics/agrieventlib exec semantic-release",
    "release:types": "pnpm --filter @agrimetrics/service-event-types exec semantic-release",
    "clean": "turbo clean",
    "clean:all": "turbo clean && rm -rf node_modules .turbo packages/*/node_modules",
    "unused:code": "knip",
    "syncpack:list": "syncpack list-mismatches",
    "syncpack:fix": "syncpack fix-mismatches",
    "syncpack:lint": "syncpack lint",
    "check:versions": "node scripts/check-versions.mjs",
    "security:audit": "audit-ci --config audit-ci.jsonc"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "audit-ci": "^7.1.0",
    "husky": "^9.1.7",
    "knip": "^6.43.0",
    "prettier": "^3.9.10",
    "syncpack": "^15.3.3",
    "turbo": "^2.11.10",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "jiti": "^2.0.0"
    }
  }
}
